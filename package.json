{
	"name": "@involvex/camsfinder",
	"private": true,
	"type": "module",
	"module": "src/index.ts",
	"bin": {
		"camsfinder": "dist/camsfinder.js",
		"camsfinder-cli": "src/index.ts"
	},
	"scripts": {
		"prebuild": "bun run check",
		"build": "bun build --target node --minify ./src/index.ts --outfile dist/camsfinder.js",
		"check": "bun run format && bun run lint:fix && bun run typecheck",
		"compile": "bun build --compile --outfile dist/camsfinder.exe src/index.ts",
		"dev": "bun src/index.ts",
		"format": "prettier . --write",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"typecheck": "tsc --noEmit"
	},
	"prettier": "@involvex/prettier-config",
	"dependencies": {
		"@types/node": "^26.6.4",
		"chromium-bidi": "^12.0.2",
		"has-flag": "^5.0.1",
		"playwright": "^1.63.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@involvex/prettier-config": "^0.0.6",
		"@types/bun": "latest",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"prettier": "^3.9.9",
		"typescript-eslint": "^8.71.0"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	}
}
